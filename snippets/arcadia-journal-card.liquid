<article class="arcadia-journal-card">
  <div class="arcadia-journal-card__visual">
    <a class="arcadia-journal-card__image" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
      {% if article.image %}
        {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '300, 500, 750, 1000', sizes: '(max-width: 600px) 85vw, (max-width: 1100px) 45vw, 33vw' }}
      {% else %}<span class="arcadia-journal-card__placeholder" aria-hidden="true">{% render 'arcadia-icon', name: 'arrow' %}</span>{% endif %}
    </a>
    {% if options.show_tags and article.tags.size > 0 %}<ul class="arcadia-journal-card__tags">
      {% for tag in article.tags limit: 3 %}<li>{{ tag | escape }}</li>{% endfor %}
    </ul>{% endif %}
  </div>
  <div class="arcadia-journal-card__body">
    {% if options.show_date or options.show_author %}<div class="arcadia-journal-card__meta">
      {% if options.show_date %}<time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'abbreviated_date' }}</time>{% endif %}
      {% if options.show_author %}<span>{{ article.author | escape }}</span>{% endif %}
    </div>{% endif %}
    <h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
    <div class="arcadia-journal-card__footer">
      {% if options.show_excerpt %}<p>{{ article.excerpt_or_content | strip_html | truncatewords: options.excerpt_words | escape }}</p>{% endif %}
      <a class="arcadia-icon-button arcadia-journal-card__read" href="{{ article.url }}" aria-label="{{ 'blog.read' | t | escape }}: {{ article.title | escape }}">{% render 'arcadia-icon', name: 'arrow' %}</a>
    </div>
  </div>
</article>
