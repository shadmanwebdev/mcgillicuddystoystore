<div class="arcadia-field">
  <label for="Variant-{{ form_id }}">{{ 'products.variant' | t }}</label
  ><select name="id" id="Variant-{{ form_id }}" data-arcadia-variant>
    {% for variant in product.variants %}
      <option
        value="{{ variant.id }}"
        {% if variant == product.selected_or_first_available_variant %}
          selected
        {% endif -%}
        {% unless variant.available %}
          disabled
        {% endunless %}
      >
        {{ variant.title | escape }} — {{ variant.price | money_with_currency -}}
        {%- unless variant.available %} — {{ 'products.sold_out' | t }}{% endunless %}
      </option>
    {% endfor %}
  </select>
</div>

{% if settings.swatches %}
  <div class="arcadia-stack">
    {% for option in product.options_with_values %}
      <div class="arcadia-row">
        {% for value in option.values -%}
          {%- if value.swatch != blank -%}
            <button
              type="button"
              class="arcadia-button arcadia-button--secondary"
              data-arcadia-option-index="{{ option.position | minus: 1 }}"
              data-arcadia-option-value="{{ value.name | escape }}"
              aria-pressed="{% if value.selected %}true{% else %}false{% endif %}"
            >
              {% render 'arcadia-swatch', swatch: value.swatch -%}
              {{- value.name | escape }}
            </button>
          {%- endif -%}
        {%- endfor %}
      </div>
    {% endfor %}
  </div>
{% endif %}
