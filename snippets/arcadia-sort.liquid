<label class="arcadia-field">
  {{- 'collections.sort' | t -}}
  <select name="sort_by">
    {% for option in sort_options %}
      <option
        value="{{ option.value }}"
        {% if option.value == sort_by %}
          selected
        {% endif %}
      >
        {{ option.name | escape }}
      </option>
    {% endfor %}
  </select></label
>
