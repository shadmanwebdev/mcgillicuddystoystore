{% if image != blank -%}
  {{-
    image
    | image_url: width: 1800
    | image_tag: widths: '300, 500, 750, 1000, 1400, 1800', sizes: sizes, loading: loading, class: class
  -}}
{%- elsif video != blank -%}
  {{- video | video_tag: controls: true, preload: 'metadata', image_size: '1000x' -}}
{%- elsif external_video != blank -%}
  {%- if external_video.type == 'youtube' -%}
    <iframe
      src="https://www.youtube-nocookie.com/embed/{{ external_video.id }}"
      title="{{ title | default: 'Video' | escape }}"
      loading="lazy"
      allow="encrypted-media; picture-in-picture"
      allowfullscreen
    ></iframe>
  {%- elsif external_video.type == 'vimeo' -%}
    <iframe
      src="https://player.vimeo.com/video/{{ external_video.id }}"
      title="{{ title | default: 'Video' | escape }}"
      loading="lazy"
      allow="fullscreen; picture-in-picture"
      allowfullscreen
    ></iframe>
  {%- endif -%}
{%- else -%}
  {{- 'product-1' | placeholder_svg_tag: 'arcadia-placeholder' -}}
{%- endif %}
