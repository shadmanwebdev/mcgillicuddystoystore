<div
  class="arcadia-heading"
  data-align="{{ alignment | default: section.settings.heading_alignment | default: 'start' }}"
>
  <div>
    {% if eyebrow != blank %}
      <p class="arcadia-eyebrow">{{ eyebrow | escape }}</p>
    {% endif -%}
    {%- if heading != blank %}
      <h2>{{ heading }}</h2>
    {% endif -%}
    {%- if description != blank %}
      <div class="arcadia-rte arcadia-muted">{{ description }}</div>
    {% endif %}
  </div>
  {% assign header_button_secondary = button_secondary | default: true, allow_false: true %}
  {% render 'arcadia-button', label: label, url: url, secondary: header_button_secondary, icon: 'arrow' %}
</div>
