{% if paginate.pages > 1 %}
  <nav class="arcadia-pagination" data-arcadia-pagination aria-label="{{ 'general.next' | t }}">
    {% if paginate.previous -%}
      <a href="{{ paginate.previous.url }}">{{ 'general.previous' | t }}</a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}">{{ part.title }}</a>
      {%- else -%}
        <span
          {% if part.title == paginate.current_page %}
            aria-current="page"
          {% endif %}
        >
          {{- part.title -}}
        </span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" data-arcadia-next>{{ 'general.next' | t }}</a>
    {%- endif %}
  </nav>
{% endif %}
