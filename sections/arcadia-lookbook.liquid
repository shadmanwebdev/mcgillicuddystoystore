{{ 'arcadia-lookbook.css' | asset_url | stylesheet_tag }}
<section class="arcadia-container arcadia-section">
  {% render 'arcadia-section-header', heading: section.settings.heading %}
  <div class="arcadia-lookbook">
    {% render 'arcadia-media', image: section.settings.image, loading: 'lazy', sizes: '100vw' %}
    {% for block in section.blocks %}
      {% assign linked_product = block.settings.product %}
      {% if linked_product != blank -%}
        <a
          class="arcadia-lookbook__point"
          href="{{ linked_product.url }}"
          style="--x:{{ block.settings.x }}%;--y:{{ block.settings.y }}%"
          {{ block.shopify_attributes }}
          ><span aria-hidden="true">+</span
          ><span class="arcadia-lookbook__label">
            {{- linked_product.title | escape }}
            {% render 'arcadia-price', target: linked_product -%}
          </span></a
        >
      {%- endif %}
    {% endfor %}
  </div>
  <ul class="arcadia-row">
    {% for block in section.blocks -%}
      {%- if block.settings.product != blank %}
        <li>
          <a href="{{ block.settings.product.url }}">{{ block.settings.product.title | escape }}</a>
        </li>
      {% endif -%}
    {%- endfor %}
  </ul>
</section>
{% schema %}
{
  "name": "Shoppable lookbook",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "At your table" },
    { "type": "image_picker", "id": "image", "label": "Scene image" }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Product hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        {
          "type": "range",
          "id": "x",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "y",
          "label": "Vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "unit": "%"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Shoppable lookbook" }]
}
{% endschema %}
