<script src="{{ 'arcadia-countdown.js' | asset_url }}" defer></script>
{{ 'arcadia-events.css' | asset_url | stylesheet_tag -}}
{{- 'arcadia-merchandising.css' | asset_url | stylesheet_tag }}
<section class="arcadia-container arcadia-section">
  <div class="arcadia-promo">
    {% render 'arcadia-section-header',
      heading: section.settings.heading,
      eyebrow: section.settings.eyebrow,
      description: section.settings.description
    -%}
    {%- render 'arcadia-countdown',
      target: section.settings.target,
      completion_message: section.settings.completion_message,
      completion_action: section.settings.completion_action
    -%}
    {%- render 'arcadia-button', label: section.settings.button_label, url: section.settings.button_link %}
  </div>
</section>
{% schema %}
{
  "name": "Countdown banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The next chapter starts here."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collect. Play. Belong."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the store"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "target",
      "label": "Deadline (ISO 8601 with offset)",
      "info": "One-shot only. No artificial recurring urgency."
    },
    {
      "type": "text",
      "id": "completion_message",
      "label": "Completion message",
      "default": "Now available"
    },
    {
      "type": "select",
      "id": "completion_action",
      "label": "Completion behavior",
      "default": "message",
      "options": [
        {
          "value": "message",
          "label": "Show message"
        },
        {
          "value": "hide",
          "label": "Hide countdown"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Countdown banner"
    }
  ]
}
{% endschema %}
