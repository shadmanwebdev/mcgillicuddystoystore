{{ 'arcadia-game-browser.css' | asset_url | stylesheet_tag }}
<script src="{{ 'arcadia-carousel.js' | asset_url }}" defer="defer"></script>
<section class="arcadia-container arcadia-section-background arcadia-game-browser" data-arcadia-module="carousel"
  data-layout="{{ section.settings.layout }}" data-contain="{{ section.settings.transparent_images }}"
  data-carousel="{{ section.settings.show_navigation }}"
  aria-label="{{ section.settings.heading | default: 'Find your game' | escape }}"
  style="--game-circle-size:{{ section.settings.circle_size }}px;--game-circle-gap:{{ section.settings.circle_gap }}px;--game-columns:{{ section.settings.columns }};--game-mobile-columns:{{ section.settings.mobile_columns }};--game-margin-top:{{ section.settings.margin_top }}px;--game-margin-bottom:{{ section.settings.margin_bottom }}px;">
  {% if section.settings.show_header %}
    <div class="arcadia-game-browser__header">
      {% if section.settings.watermark != blank %}<span class="arcadia-game-browser__watermark" aria-hidden="true">{{ section.settings.watermark | escape }}</span>{% endif %}
      {% render 'arcadia-section-header', heading: section.settings.heading, eyebrow: section.settings.eyebrow, description: section.settings.description, label: section.settings.button_label, url: section.settings.button_link %}
    </div>
  {% endif %}
  {% if section.blocks.size > 0 %}
    <ul id="GameTrack-{{ section.id }}" class="arcadia-game-browser__track" data-carousel-track aria-label="Game collections" tabindex="0">
      {% for block in section.blocks %}
        <li {{ block.shopify_attributes }}>
          {% render 'arcadia-game-card', collection: block.settings.collection, image: block.settings.image, artwork: block.settings.artwork, title: block.settings.title, description: block.settings.description, url: block.settings.url, logo: block.settings.logo, accent: block.settings.color, gradient: block.settings.gradient, lift: block.settings.hover %}
        </li>
      {% endfor %}
    </ul>
    {% if section.settings.show_navigation %}
      <div class="arcadia-game-browser__controls" data-carousel-controls hidden>
        <button type="button" class="arcadia-button arcadia-button--secondary" data-carousel-direction="-1" aria-controls="GameTrack-{{ section.id }}" aria-label="Previous game collections">←</button>
        <button type="button" class="arcadia-button arcadia-button--secondary" data-carousel-direction="1" aria-controls="GameTrack-{{ section.id }}" aria-label="Next game collections">→</button>
      </div>
    {% endif %}
  {% elsif request.design_mode %}
    <p class="arcadia-muted">Add collection blocks to build your game selection.</p>
  {% endif %}
</section>
{% schema %}
{
  "name": "Shop by game",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show section header",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your game."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "One table. Endless worlds."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ]
    },
    {
      "type": "text",
      "id": "watermark",
      "label": "Watermark background text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave blank to hide."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "default": "vertical",
      "info": "Vertical: image above title. Horizontal: image beside title.",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "circle",
          "label": "Round image with overlay"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "transparent_images",
      "label": "Adapt for transparent image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation buttons",
      "default": true,
      "info": "Enables scrolling. Arrows appear when cards overflow."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "circle_size",
      "max": 320,
      "unit": "px",
      "default": 200,
      "min": 120,
      "step": 10,
      "label": "Maximum circle size"
    },
    {
      "type": "range",
      "id": "circle_gap",
      "max": 100,
      "unit": "px",
      "default": 64,
      "min": 24,
      "step": 4,
      "label": "Circle spacing"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection / game",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom artwork"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Custom URL"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Game logo"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Accent",
          "info": "Leave blank to inherit the theme accent."
        },
        {
          "type": "color_background",
          "id": "gradient",
          "label": "Background gradient",
          "info": "Artwork background only, preserving text contrast."
        },
        {
          "type": "checkbox",
          "id": "hover",
          "label": "Lift on hover",
          "default": true
        },
        {
          "info": "Custom artwork overrides this selection.",
          "type": "select",
          "default": "collection",
          "options": [
            {
              "value": "collection",
              "label": "Use collection image"
            },
            {
              "value": "pokemon",
              "label": "Pikachu"
            },
            {
              "value": "magic",
              "label": "Magic illustration"
            },
            {
              "value": "onepiece",
              "label": "Luffy"
            },
            {
              "value": "warhammer",
              "label": "Space Marine"
            },
            {
              "value": "jellycat",
              "label": "Jellycat pink bunny"
            },
            {
              "value": "lego",
              "label": "Colorful LEGO bricks"
            }
          ],
          "id": "artwork",
          "label": "Included artwork"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Shop by game",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
