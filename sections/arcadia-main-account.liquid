<section class="arcadia-container arcadia-section arcadia-stack">
  <div class="arcadia-row arcadia-between">
    <h1>{{ 'customer.account' | t }}</h1>
    <a href="{{ routes.account_logout_url }}">{{ 'customer.logout' | t }}</a>
  </div>
  <div class="arcadia-split">
    <div>
      <h2>{{ 'customer.orders' | t }}</h2>
      {% paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 %}
          <div class="arcadia-rte">
            <table>
              <thead>
                <tr>
                  <th>{{ 'customer.order' | t }}</th>
                  <th>{{ 'customer.date' | t }}</th>
                  <th>{{ 'customer.payment' | t }}</th>
                  <th>{{ 'customer.fulfillment' | t }}</th>
                  <th>{{ 'customer.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {% for order in customer.orders %}
                  <tr>
                    <td>
                      <a href="{{ order.customer_url }}">{{ order.name }}</a>
                    </td>
                    <td>{{ order.created_at | date: format: 'abbreviated_date' }}</td>
                    <td>{{ order.financial_status_label }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_price | money_with_currency }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <p>{{ 'customer.no_orders' | t }}</p>
        {% endif -%}
        {%- render 'arcadia-pagination', paginate: paginate -%}
      {%- endpaginate %}
    </div>
    <div>
      <h2>{{ 'customer.addresses' | t }}</h2>
      {{ customer.default_address | format_address -}}
      <a href="{{ routes.account_addresses_url }}">{{ 'customer.addresses' | t }} ({{ customer.addresses_count }})</a>
    </div>
  </div>
</section>
{% schema %}{"name":"Customer account","settings":[]} {% endschema %}
