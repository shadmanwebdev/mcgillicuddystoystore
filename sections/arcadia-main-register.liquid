<section class="arcadia-container arcadia-section arcadia-narrow arcadia-stack">
  <h1>{{ 'customer.register' | t }}</h1>
  {% form 'create_customer', class: 'arcadia-stack' %}
    {{ form.errors | default_errors -}}
    <label class="arcadia-field">
      {{- 'customer.first_name' | t -}}
      <input
        class="arcadia-input"
        type="text"
        name="customer[first_name]"
        autocomplete="given-name"
        value="{{ form.first_name | escape }}"></label
    ><label class="arcadia-field">
      {{- 'customer.last_name' | t -}}
      <input
        class="arcadia-input"
        type="text"
        name="customer[last_name]"
        autocomplete="family-name"
        value="{{ form.last_name | escape }}"></label
    ><label class="arcadia-field">
      {{- 'customer.email' | t -}}
      <input
        class="arcadia-input"
        type="email"
        name="customer[email]"
        autocomplete="email"
        value="{{ form.email | escape }}"
        required></label
    ><label class="arcadia-field">
      {{- 'customer.password' | t -}}
      <input
        class="arcadia-input"
        type="password"
        name="customer[password]"
        autocomplete="new-password"
        required></label
    ><button class="arcadia-button" type="submit">{{ 'customer.register' | t }}</button>
  {% endform %}
  <a href="{{ routes.account_login_url }}">{{ 'customer.login' | t }}</a>
</section>
{% schema %}{"name":"Customer registration","settings":[]} {% endschema %}
