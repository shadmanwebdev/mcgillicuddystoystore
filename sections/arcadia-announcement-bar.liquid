{% if section.settings.text != blank %}
  <div class="arcadia-announcement">
    {% if section.settings.link -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      {{- section.settings.text | escape -}}
    {%- endif %}
  </div>
{% endif -%}
{% schema %}{"name":"Announcement","settings":[{"type":"text","id":"text","label":"Merchant announcement"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Announcement"}]}{% endschema %}
