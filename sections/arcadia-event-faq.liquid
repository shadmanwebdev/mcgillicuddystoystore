<section class="arcadia-container arcadia-section arcadia-narrow">
  {% render 'arcadia-section-header', heading: section.settings.heading -%}
  {%- if metaobject.faq != blank %}
    <div class="arcadia-rte">{{ metaobject.faq | metafield_tag }}</div>
  {% endif -%}
  {%- for block in section.blocks %}
    <div {{ block.shopify_attributes }}>
      {% render 'arcadia-accordion', heading: block.settings.question, content: block.settings.answer %}
    </div>
  {% endfor %}
</section>
{% schema %}
{
  "name": "Event FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good questions. Clear answers."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Event FAQ"
    }
  ]
}
{% endschema %}
