{{ 'arcadia-community-cta.css' | asset_url | stylesheet_tag }}
<section class="arcadia-community arcadia-section-background" style="--community-top:{{ section.settings.padding_top }}px;--community-bottom:{{ section.settings.padding_bottom }}px;--community-align:{{ section.settings.heading_alignment }};" aria-labelledby="CommunityTitle-{{ section.id }}">
  <div class="arcadia-container arcadia-content-container arcadia-community__panel" data-art="{{ section.settings.show_artwork }}" data-position="{{ section.settings.image_position }}">
    <div class="arcadia-community__copy">
      {% if section.settings.icon != blank %}<span class="arcadia-community__symbol" aria-hidden="true">{{ section.settings.icon | escape }}</span>{% endif %}
      {% if section.settings.eyebrow != blank %}<p class="arcadia-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="CommunityTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.description != blank %}<div class="arcadia-community__description">{{ section.settings.description }}</div>{% endif %}
      {% if section.settings.member_count != blank %}<p>{{ section.settings.member_count | escape }}</p>{% endif %}
      {% if section.settings.button_link != blank or settings.discord_url != blank %}
        <div class="arcadia-community__actions">
          {% render 'arcadia-button', label: section.settings.button_label, url: section.settings.button_link, icon: 'arrow' %}
          {% render 'arcadia-button', label: section.settings.platform_label, url: settings.discord_url, secondary: true %}
        </div>
      {% endif %}
    </div>
    {% if section.settings.show_artwork %}
      <div class="arcadia-community__art" aria-hidden="true">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 900 | image_tag: widths: '300, 600, 900', sizes: '(max-width: 700px) 70vw, 30vw', loading: 'lazy', alt: '' }}
        {% else %}
          {% render 'arcadia-community-art' %}
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Community call to action",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The next chapter starts here."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collect. Play. Belong."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the store"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Community artwork"
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Community symbol"
    },
    {
      "type": "text",
      "id": "member_count",
      "label": "Manual member count display",
      "info": "Enter an accurate count and update it yourself; no live analytics connection."
    },
    {
      "type": "text",
      "id": "platform_label",
      "label": "Community platform label",
      "default": "Discord"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ]
    },
    {
      "id": "show_artwork",
      "type": "checkbox",
      "label": "Show artwork",
      "default": true
    },
    {
      "id": "image_position",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "type": "select",
      "label": "Desktop artwork position",
      "default": "end"
    },
    {
      "unit": "px",
      "default": 40,
      "step": 4,
      "max": 120,
      "id": "padding_top",
      "type": "range",
      "min": 0,
      "label": "Top spacing"
    },
    {
      "unit": "px",
      "default": 40,
      "step": 4,
      "max": 120,
      "id": "padding_bottom",
      "type": "range",
      "min": 0,
      "label": "Bottom spacing"
    }
  ],
  "presets": [
    {
      "name": "Community call to action"
    }
  ]
}
{% endschema %}
