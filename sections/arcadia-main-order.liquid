<section class="arcadia-container arcadia-section arcadia-stack">
  <a href="{{ routes.account_url }}">{{ 'customer.return' | t }}</a>
  <h1>
    {{ 'customer.order' | t }}
    {{ order.name }}
  </h1>
  <p>
    {{ order.created_at | date: format: 'abbreviated_date' }} · {{ order.financial_status_label }} ·
    {{ order.fulfillment_status_label }}
  </p>
  {% if order.cancelled %}
    <p>{{ order.cancelled_at | date: format: 'abbreviated_date' }} — {{ order.cancel_reason_label }}</p>
  {% endif %}
  <div class="arcadia-stack">
    {% for item in order.line_items %}
      <div class="arcadia-card__body">
        <h2 class="arcadia-card__title">
          {% if item.product.url -%}
            <a href="{{ item.product.url }}">{{ item.title | escape }}</a>
          {%- else -%}
            {{- item.title | escape -}}
          {%- endif %}
        </h2>
        <p>
          {{ item.quantity }} × {{ item.final_price | money_with_currency }} =
          {{ item.final_line_price | money_with_currency }}
        </p>
        {% if item.fulfillment %}
          <p>
            {{ item.fulfillment.created_at | date: format: 'abbreviated_date' -}}
            {%- if item.fulfillment.tracking_url %}
              ·
              <a href="{{ item.fulfillment.tracking_url }}">
                {{- item.fulfillment.tracking_company | escape }}
                {{ item.fulfillment.tracking_number | escape -}}
              </a>
            {%- endif %}
          </p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  <div>
    {% for discount in order.cart_level_discount_applications %}
      <p>{{ discount.title | escape }} −{{ discount.total_allocated_amount | money }}</p>
    {% endfor -%}
    {%- for shipping in order.shipping_methods %}
      <p>{{ shipping.title | escape }}: {{ shipping.price | money }}</p>
    {% endfor -%}
    {%- for tax in order.tax_lines %}
      <p>
        {{ tax.title | escape }}
        {{ tax.rate | times: 100 }}%: {{ tax.price | money }}
      </p>
    {% endfor -%}
    <strong>{{ 'customer.total' | t }}: {{ order.total_price | money_with_currency }}</strong>
  </div>
  <div class="arcadia-split">
    <div>
      <h2>{{ 'customer.billing' | t }}</h2>
      {{ order.billing_address | format_address }}
    </div>
    <div>
      <h2>{{ 'customer.shipping' | t }}</h2>
      {{ order.shipping_address | format_address }}
    </div>
  </div>
</section>
{% schema %}{"name":"Customer order","settings":[]} {% endschema %}
