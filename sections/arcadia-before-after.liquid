{{ 'arcadia-before-after.css' | asset_url | stylesheet_tag }}
<script src="{{ 'arcadia-before-after.js' | asset_url }}" defer></script>
<section class="arcadia-container arcadia-section">
  {% render 'arcadia-section-header', heading: section.settings.heading %}
  <div data-arcadia-module="before-after" class="arcadia-compare" style="--position:50%">
    <div class="arcadia-compare__images">
      <div>{% render 'arcadia-media', image: section.settings.before, loading: 'lazy', sizes: '100vw' %}</div>
      <div class="arcadia-compare__after">
        {% render 'arcadia-media', image: section.settings.after, loading: 'lazy', sizes: '100vw' %}
      </div>
    </div>
    <label class="arcadia-field">
      {{- section.settings.control_label | escape -}}
      <input type="range" min="0" max="100" value="50" data-arcadia-compare
    ></label>
    <div class="arcadia-row">
      <span>{{ section.settings.before_label | escape }}</span><span>{{ section.settings.after_label | escape }}</span>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Before and after",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for your collection" },
    { "type": "image_picker", "id": "before", "label": "Before image" },
    { "type": "image_picker", "id": "after", "label": "After image" },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After" },
    { "type": "text", "id": "control_label", "label": "Slider label", "default": "Compare images" }
  ],
  "presets": [{ "name": "Before and after" }]
}
{% endschema %}
