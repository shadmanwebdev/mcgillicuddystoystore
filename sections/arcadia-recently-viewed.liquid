{% if settings.recently_viewed %}
  <section
    class="arcadia-container arcadia-section"
    data-arcadia-module="recently-viewed"
    data-arcadia-current-product="{{ product.handle }}"
    hidden
  >
    {% render 'arcadia-section-header', heading: section.settings.heading %}
    <div class="arcadia-grid" data-arcadia-recent-grid></div>
  </section>
{% endif -%}
{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Back on your radar"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recently viewed"
    }
  ]
}
{% endschema %}
