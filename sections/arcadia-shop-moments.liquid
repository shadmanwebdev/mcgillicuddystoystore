{{ 'arcadia-breathing-space.css' | asset_url | stylesheet_tag }}
<section class="arcadia-pause arcadia-section-background" style="--pause-top:{{ section.settings.padding_top }}px;--pause-bottom:{{ section.settings.padding_bottom }}px" aria-labelledby="Moments-{{ section.id }}">
  <div class="arcadia-container arcadia-moments">
    <div class="arcadia-pause__copy">
      {% if section.settings.eyebrow != blank %}<p class="arcadia-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="Moments-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <div class="arcadia-pause__description">{{ section.settings.description }}</div>
      {% render 'arcadia-button', label: section.settings.button_label, url: section.settings.button_link, icon: 'arrow' %}
    </div>
    <div class="arcadia-moments__tiles">
      {% for block in section.blocks %}
        {% liquid
          assign target = block.settings.collection.url
          assign title = block.settings.title | default: block.settings.collection.title
          assign artwork = 'arcadia-game-' | append: block.settings.artwork | append: '.jpg'
          if block.settings.artwork == 'pokemon'
            assign artwork = 'arcadia-game-pokemon.png'
          endif
        %}
        <div class="arcadia-moments__tile" {{ block.shopify_attributes }}>
          {% if target != blank %}<a href="{{ target }}">{% endif %}
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: widths: '240, 400, 600, 800', sizes: '(max-width: 700px) 70vw, 23vw', loading: 'lazy', alt: '' }}
            {% else %}
              <img src="{{ artwork | asset_url }}" width="600" height="800" loading="lazy" alt="">
            {% endif %}
            <span>{{ title | escape }} <span aria-hidden="true">↗</span></span>
          {% if target != blank %}</a>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Shop the hobby","max_blocks":3,"settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Find your kind of play"},
{"type":"text","id":"heading","label":"Heading","default":"Little moments. Big adventures."},
{"type":"richtext","id":"description","label":"Description","default":"<p>Build something. Start a collection. Make time for what you love.</p>"},
{"type":"text","id":"button_label","label":"Button label","default":"Shop all"},
{"type":"url","id":"button_link","label":"Button link"},
{"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":120,"step":4,"default":40,"unit":"px"},
{"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":120,"step":4,"default":40,"unit":"px"}
],"blocks":[{"type":"moment","name":"Hobby image","settings":[
{"type":"collection","id":"collection","label":"Collection"},
{"type":"text","id":"title","label":"Label"},
{"type":"image_picker","id":"image","label":"Image","info":"Use products or game artwork. No people unless explicitly requested."},
{"type":"select","id":"artwork","label":"Default artwork","default":"lego","options":[{"value":"lego","label":"LEGO"},{"value":"pokemon","label":"Pokémon"},{"value":"warhammer","label":"Warhammer"},{"value":"jellycat","label":"Jellycat"}]}
]}],"presets":[{"name":"Shop the hobby","blocks":[{"type":"moment"},{"type":"moment"},{"type":"moment"}]}]}
{% endschema %}
