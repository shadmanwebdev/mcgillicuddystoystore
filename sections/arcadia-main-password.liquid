<section class="arcadia-container arcadia-section arcadia-narrow arcadia-stack">
  <p class="arcadia-logo">{{ shop.name | escape }}</p>
  <h1>{{ section.settings.heading | escape }}</h1>
  {% if shop.password_message != blank %}
    <div class="arcadia-rte">{{ shop.password_message }}</div>
  {% endif -%}
  {%- if section.settings.newsletter %}{% render 'arcadia-newsletter-form' %}{% endif %}
  <details>
    <summary>{{ 'password.enter' | t }}</summary>
    {% form 'storefront_password', class: 'arcadia-stack' %}
      {{ form.errors | default_errors -}}
      <label class="arcadia-field">
        {{- 'password.password' | t -}}
        <input class="arcadia-input" type="password" name="password" autocomplete="current-password" required></label
      ><button class="arcadia-button" type="submit">{{ 'password.submit' | t }}</button>
    {% endform %}
  </details>
  <a href="{{ routes.root_url }}admin">{{ 'password.owner' | t }}</a>
</section>
{% schema %}{"name":"Password page","settings":[{"type":"text","id":"heading","label":"Heading","default":"A new chapter is coming."},{"type":"checkbox","id":"newsletter","label":"Newsletter","default":true}]}{% endschema %}
