{{ 'arcadia-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'arcadia-countdown.js' | asset_url }}" defer></script>
<section
  class="arcadia-hero{% if settings.holo_enabled and settings.holo_heroes %} arcadia-holo{% endif %}"
  data-holo-static="{{ settings.holo_static }}"
  data-holo-hover="{{ settings.holo_hover }}"
>
  <div class="arcadia-container arcadia-hero__inner">
    <div class="arcadia-hero__copy">
      <p class="arcadia-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <div class="arcadia-rte">{{ section.settings.description }}</div>
      {% render 'arcadia-countdown', target: section.settings.target -%}
      {%- assign product_url = section.settings.product.url | default: section.settings.button_link -%}
      {%- render 'arcadia-button', label: section.settings.button_label, url: product_url %}
    </div>
    <div class="arcadia-hero__art">
      {% assign image = section.settings.image | default: section.settings.product.featured_image -%}
      {%- if image != blank %}
        <div class="arcadia-hero__image">
          {% render 'arcadia-media', image: image, loading: 'eager', sizes: '50vw' %}
        </div>
      {% else -%}
        {%- render 'arcadia-hero-art' -%}
      {%- endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Release hero",
  "settings": [
    {
      "default": "The next chapter starts here.",
      "id": "heading",
      "label": "Heading",
      "type": "text"
    },
    {
      "default": "Collect. Play. Belong.",
      "id": "eyebrow",
      "label": "Eyebrow",
      "type": "text"
    },
    {
      "id": "description",
      "label": "Description",
      "type": "richtext"
    },
    {
      "default": "Explore the store",
      "id": "button_label",
      "label": "Button label",
      "type": "text"
    },
    {
      "id": "button_link",
      "label": "Button link",
      "type": "url"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Release product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Artwork"
    },
    {
      "type": "text",
      "id": "target",
      "label": "Release time (ISO 8601 with offset)"
    }
  ],
  "presets": [
    {
      "name": "Release hero"
    }
  ]
}
{% endschema %}
