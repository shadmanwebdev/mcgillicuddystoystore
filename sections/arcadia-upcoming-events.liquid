{{ 'arcadia-event-styles.css' | asset_url | stylesheet_tag }}
{{ 'arcadia-events.css' | asset_url | stylesheet_tag }}
<script src="{{ 'arcadia-events.js' | asset_url }}" defer></script>
<script src="{{ 'arcadia-countdown.js' | asset_url }}" defer></script>
<script src="{{ 'arcadia-calendar.js' | asset_url }}" defer></script>
<script src="{{ 'arcadia-slider.js' | asset_url }}" defer></script>
<section
  class="arcadia-container arcadia-section arcadia-events"
  data-arcadia-module="events slider"
  data-layout="strip"
>
  {% render 'arcadia-section-header',
    heading: section.settings.heading,
    eyebrow: section.settings.eyebrow,
    label: section.settings.link_label,
    url: section.settings.link
  -%}
  {%- render 'arcadia-slider-controls' %}
  <div data-arcadia-slider-track class="arcadia-scroll" style="--arcadia-columns:3">
    {% assign rendered_events = 0 -%}
    {%- assign now_seconds = 'now' | date: '%s' | plus: 0 -%}
    {%- if section.settings.source != 'manual' -%}
      {%- assign sorted_events = metaobjects.arcadia_event.values | sort: 'start_at.value' -%}
      {%- for event in sorted_events -%}
        {%- if rendered_events >= section.settings.limit %}{% break %}{% endif -%}
        {%- if event.status.value == 'completed' or event.status.value == 'cancelled' %}{% continue %}{% endif -%}
        {%- assign start_seconds = event.start_at.value | date: '%s' | plus: 0 -%}
        {%- if event.system.id != metaobject.system.id and start_seconds >= now_seconds -%}
          {%- render 'arcadia-event-card',
            event: event,
            show_countdown: section.settings.countdown,
            show_calendar: section.settings.calendar,
            card_style: section.settings.card_style
          -%}
          {%- assign rendered_events = rendered_events | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if section.settings.source != 'metaobjects' or rendered_events == 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.status == 'completed' or block.settings.status == 'cancelled' %}{% continue %}{% endif -%}
        {%- assign start_seconds = block.settings.start_at | date: '%s' | plus: 0 -%}
        {%- if start_seconds >= now_seconds or block.settings.start_at == blank -%}
          {%- render 'arcadia-event-card',
            event: block.settings,
            attributes: block.shopify_attributes,
            show_countdown: section.settings.countdown,
            show_calendar: section.settings.calendar,
            card_style: section.settings.card_style
          -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif %}
  </div>
  <p data-arcadia-event-empty hidden>{{ 'events.empty' | t }}</p>
</section>
{% schema %}
{
  "name": "Upcoming event strip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upcoming event strip"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Meet. Play. Compete."
    },
    {
      "type": "select",
      "id": "source",
      "label": "Event source",
      "default": "both",
      "options": [
        {
          "value": "both",
          "label": "Metaobjects and blocks"
        },
        {
          "value": "metaobjects",
          "label": "Metaobjects, blocks as fallback"
        },
        {
          "value": "manual",
          "label": "Manual blocks"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Metaobject count",
      "min": 3,
      "max": 48,
      "step": 3,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "countdown",
      "label": "Countdowns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "calendar",
      "label": "Calendar links",
      "default": true
    },
    {
      "type": "url",
      "id": "link",
      "label": "Heading link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Heading link label",
      "default": "Explore events"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "clean",
      "options": [
        {
          "value": "clean",
          "label": "clean"
        },
        {
          "value": "neon",
          "label": "neon"
        },
        {
          "value": "poster",
          "label": "poster"
        },
        {
          "value": "compact",
          "label": "compact"
        },
        {
          "value": "competitive",
          "label": "competitive"
        },
        {
          "value": "minimal",
          "label": "minimal"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_venue",
      "label": "Show venue",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_capacity",
      "label": "Show capacity",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_game",
      "label": "Show game",
      "default": true
    },
    {
      "type": "text",
      "id": "completion_message",
      "label": "Countdown completion message",
      "default": "The event has started"
    },
    {
      "type": "select",
      "id": "completion_action",
      "label": "Countdown completion",
      "default": "message",
      "options": [
        {
          "value": "message",
          "label": "Show message"
        },
        {
          "value": "hide",
          "label": "Hide countdown"
        },
        {
          "value": "completed",
          "label": "Mark card completed locally"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Community event"
        },
        {
          "type": "textarea",
          "id": "short_description",
          "label": "Short description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Artwork"
        },
        {
          "type": "text",
          "id": "start_at",
          "label": "Start (ISO 8601 with offset)",
