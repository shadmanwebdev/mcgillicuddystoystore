          "info": "Include the correct currency. Leave blank when unspecified."
        },
        {
          "type": "text",
          "id": "capacity",
          "label": "Capacity (merchant supplied)"
        },
        {
          "type": "text",
          "id": "spaces_remaining",
          "label": "Spaces remaining (merchant supplied)"
        },
        {
          "type": "select",
          "id": "status",
          "label": "Status (merchant supplied)",
          "default": "upcoming",
          "options": [
            {
              "value": "upcoming",
              "label": "upcoming"
            },
            {
              "value": "registration-open",
              "label": "registration open"
            },
            {
              "value": "filling-fast",
              "label": "filling fast"
            },
            {
              "value": "sold-out",
              "label": "sold out"
            },
            {
              "value": "today",
              "label": "today"
            },
            {
              "value": "live",
              "label": "live"
            },
            {
              "value": "completed",
              "label": "completed"
            },
            {
              "value": "cancelled",
              "label": "cancelled"
            }
          ]
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Custom badge"
        },
        {
          "type": "url",
          "id": "registration_link",
          "label": "Registration URL"
        },
        {
          "type": "url",
          "id": "ticket_link",
          "label": "Ticket URL"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Entry product"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Event landing page URL"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Custom action label"
        },
        {
          "type": "color",
          "id": "accent",
          "label": "Accent",
          "default": "#beff50"
        },
        {
          "type": "color_background",
          "id": "background",
          "label": "Card background"
        },
        {
          "type": "range",
          "id": "overlay",
          "label": "Artwork darkening",
          "min": 0,
          "max": 80,
          "step": 5,
          "default": 20,
          "unit": "%"
        },
        {
          "type": "checkbox",
          "id": "animate",
          "label": "Lift on hover",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Upcoming event strip"
    }
  ]
}
{% endschema %}
