        },
        {
          "type": "text",
          "id": "end_at",
          "label": "End (ISO 8601 with offset)"
        },
        {
          "type": "text",
          "id": "game",
          "label": "Game"
        },
        {
          "type": "text",
          "id": "event_type",
          "label": "Event type"
        },
        {
          "type": "text",
          "id": "venue",
          "label": "Venue"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "entry_price",
