{{ 'arcadia-event-styles.css' | asset_url | stylesheet_tag }}
{{ 'arcadia-events.css' | asset_url | stylesheet_tag }}
{{ 'arcadia-upcoming-events.css' | asset_url | stylesheet_tag }}
<script src="{{ 'arcadia-events.js' | asset_url }}" defer></script>
<script src="{{ 'arcadia-countdown.js' | asset_url }}" defer></script>
{% if section.settings.calendar %}<script src="{{ 'arcadia-calendar.js' | asset_url }}" defer></script>{% endif %}
<script src="{{ 'arcadia-carousel.js' | asset_url }}" defer></script>
{% liquid
  assign header_secondary = false
  if section.settings.button_style == 'secondary'
    assign header_secondary = true
  endif
%}
<section class="arcadia-container arcadia-section-background arcadia-events arcadia-upcoming"
  data-arcadia-module="events carousel" data-layout="strip"
  data-desktop-carousel="{{ section.settings.desktop_carousel }}" data-mobile-carousel="{{ section.settings.mobile_carousel }}"
  data-wrap="{{ section.settings.content_wrap }}" data-surface="{{ section.settings.card_surface }}"
  data-align="{{ section.settings.content_alignment }}" data-image-ratio="{{ section.settings.image_ratio }}"
  style="--upcoming-columns:{{ section.settings.columns }};--upcoming-mobile-columns:{{ section.settings.mobile_columns }};--upcoming-ratio:{{ section.settings.image_ratio }};--upcoming-fit:{{ section.settings.image_fit }};--upcoming-top:{{ section.settings.padding_top }}px;--upcoming-bottom:{{ section.settings.padding_bottom }}px;">
  {% if section.settings.show_header %}
    <div class="arcadia-upcoming__header">
      {% if section.settings.watermark != blank %}<span class="arcadia-upcoming__watermark" aria-hidden="true">{{ section.settings.watermark | escape }}</span>{% endif %}
      {% render 'arcadia-section-header', heading: section.settings.heading, eyebrow: section.settings.eyebrow, description: section.settings.description, label: section.settings.link_label, url: section.settings.link, button_secondary: header_secondary %}
    </div>
  {% endif %}
  <div id="EventTrack-{{ section.id }}" class="arcadia-upcoming__track" data-carousel-track tabindex="0" role="region" aria-label="{{ section.settings.heading | default: 'Upcoming events' | escape }}">
    {% assign rendered_events = 0 %}
    {% assign now_seconds = 'now' | date: '%s' | plus: 0 %}
    {% if section.settings.source != 'manual' %}
      {% assign sorted_events = metaobjects.arcadia_event.values | sort: 'start_at.value' %}
      {% for event in sorted_events %}
        {% if rendered_events >= section.settings.limit %}{% break %}{% endif %}
        {% if event.status.value == 'completed' or event.status.value == 'cancelled' %}{% continue %}{% endif %}
        {% assign start_seconds = event.start_at.value | date: '%s' | plus: 0 %}
        {% if event.system.id != metaobject.system.id and start_seconds >= now_seconds %}
          {% render 'arcadia-event-card', event: event, show_countdown: section.settings.countdown, show_calendar: section.settings.calendar, card_style: section.settings.card_style, card_options: section.settings %}
          {% assign rendered_events = rendered_events | plus: 1 %}
        {% endif %}
      {% endfor %}
    {% endif %}
    {% if section.settings.source != 'metaobjects' or rendered_events == 0 %}
      {% for block in section.blocks %}
        {% if rendered_events >= section.settings.limit %}{% break %}{% endif %}
        {% if block.settings.status == 'completed' or block.settings.status == 'cancelled' %}{% continue %}{% endif %}
        {% assign start_seconds = block.settings.start_at | date: '%s' | plus: 0 %}
        {% if start_seconds >= now_seconds or block.settings.start_at == blank %}
          {% render 'arcadia-event-card', event: block.settings, attributes: block.shopify_attributes, show_countdown: section.settings.countdown, show_calendar: section.settings.calendar, card_style: section.settings.card_style, card_options: section.settings %}
          {% assign rendered_events = rendered_events | plus: 1 %}
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
  {% if section.settings.navigation %}
    <div class="arcadia-upcoming__controls" data-carousel-controls hidden>
      <button class="arcadia-icon-button" type="button" data-carousel-direction="-1" aria-label="{{ 'general.previous' | t }}" aria-controls="EventTrack-{{ section.id }}">←</button>
      <button class="arcadia-icon-button" type="button" data-carousel-direction="1" aria-label="{{ 'general.next' | t }}" aria-controls="EventTrack-{{ section.id }}">→</button>
    </div>
  {% endif %}
  <div class="arcadia-upcoming__empty" data-arcadia-event-empty {% if rendered_events > 0 %}hidden{% endif %}>
    <p>{{ 'events.upcoming_empty' | t }}</p>
    {% if request.design_mode %}<p>Add Event blocks or publish upcoming arcadia_event metaobjects. Dates, prices and availability come from your event data.</p>{% endif %}
  </div>
</section>
{% schema %}
{
