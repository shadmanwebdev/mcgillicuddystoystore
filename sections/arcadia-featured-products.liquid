<section class="arcadia-container arcadia-section">
  {% render 'arcadia-section-header',
    heading: section.settings.heading,
    eyebrow: section.settings.eyebrow,
    description: section.settings.description,
    label: section.settings.link_label,
    url: section.settings.collection.url
  %}
  <div class="arcadia-grid">
    {% for product in section.settings.collection.products limit: section.settings.limit -%}
      {%- render 'arcadia-product-card', product: product -%}
    {%- else -%}
      {%- if request.design_mode %}
        <p>Select a collection to show products.</p>
      {% endif -%}
    {%- endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The next chapter starts here."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collect. Play. Belong."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Collection link label",
      "default": "Shop collection"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
